# Adresse de l'application : celle AVEC pool de connexions (hôte en `-pooler`
# chez Neon). Beaucoup de requêtes courtes, peu de connexions ouvertes.
DATABASE_URL="postgresql://joie:joie@localhost:5433/joie"

# Adresse des migrations : la connexion DIRECTE, la même sans `-pooler`.
# Prisma pose un verrou de session avant de migrer, et un pool en mode
# transaction ne sait pas le tenir. Facultative en local, où l'adresse
# ci-dessus est déjà directe.
# MIGRATE_DATABASE_URL="postgresql://…@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"
