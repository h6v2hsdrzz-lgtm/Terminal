{
  "name": "bande",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrer": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "verifier:palette": "node scripts/valider-palette.mjs",
    "test": "vitest run",
    "test:suivi": "vitest",
    "vercel-build": "prisma generate && prisma migrate deploy && next build",
    "postinstall": "prisma generate",
    "medias:migrer": "tsx --conditions=react-server --env-file=.env scripts/migrer-medias.ts",
    "medias:verifier": "tsx --conditions=react-server --env-file=.env scripts/migrer-medias.ts --verifier",
    "cartes:images": "tsx scripts/images-cartes.ts",
    "cartes:verifier": "tsx scripts/images-cartes.ts --verifier",
    "pousse:cles": "tsx scripts/cles-vapid.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "motion": "^13.2.0",
    "mp4-muxer": "^5.2.2",
    "next": "16.3.4",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.0"
  }
}
