# Base PostgreSQL.
#
# En local : n'importe quelle instance PostgreSQL ; le README donne la ligne
# Docker qui correspond à cette adresse.
# En ligne : l'adresse AVEC pool (chez Neon, l'hôte porte `-pooler`).
DATABASE_URL="postgresql://joie:joie@localhost:5433/bande"

# Adresse DIRECTE (sans `-pooler`), pour les migrations seulement. Prisma pose
# un verrou de session avant de migrer, qu'un pool en mode transaction ne sait
# pas tenir. Inutile en local, où l'adresse ci-dessus est déjà directe.
# MIGRATE_DATABASE_URL="postgresql://…@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Secret de signature des sessions. N'importe quelle chaîne longue et aléatoire :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_SESSION="developpement-uniquement-a-remplacer-en-ligne"
