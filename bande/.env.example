# Base PostgreSQL.
#
# En local : n'importe quelle instance PostgreSQL ; le README donne la ligne
# Docker qui correspond à cette adresse.
# En ligne : l'adresse AVEC pool (chez Neon, l'hôte porte `-pooler`).
DATABASE_URL="postgresql://joie:joie@localhost:5433/bande"

# Adresse DIRECTE (sans `-pooler`), pour les migrations seulement. Prisma pose
# un verrou de session avant de migrer, qu'un pool en mode transaction ne sait
# pas tenir. Inutile en local, où l'adresse ci-dessus est déjà directe.
# MIGRATE_DATABASE_URL="postgresql://…@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Secret de signature des sessions. N'importe quelle chaîne longue et aléatoire :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_SESSION="developpement-uniquement-a-remplacer-en-ligne"

# ── Stockage des médias ─────────────────────────────────────────────────────
#
# Les quatre ensemble, ou aucune. Tant qu'il en manque une, les photos, vidéos
# et sons restent dans PostgreSQL — c'est ce qui a marché jusqu'ici, et ça
# continue de marcher. Dès que les quatre sont là, les NOUVEAUX médias partent
# chez Cloudflare R2, et `npm run medias:migrer` y emmène les anciens.
#
# Où les trouver : tableau de bord Cloudflare → R2 → « Manage API tokens ».
# Le jeton doit avoir le droit « Object Read & Write » sur ce seau, et rien
# d'autre. Le seau reste PRIVÉ : l'application sert les octets elle-même, après
# avoir vérifié la session. Un seau public rendrait chaque photo lisible par
# quiconque devine une clé.
#
# R2_COMPTE=l-identifiant-de-compte-cloudflare
# R2_SEAU=journal-de-joie
# R2_CLE=l-identifiant-du-jeton
# R2_SECRET=le-secret-du-jeton
