// Modèle de données du repaire.
//
// Les tables portent le préfixe `bande_` : elles partagent la base hébergée
// avec la v1, qui garde les siennes. Séparer par un préfixe plutôt que par un
// schéma PostgreSQL évite d'avoir à créer quoi que ce soit à la main dans la
// console Neon — le déploiement reste une seule variable à coller.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Une bande. Le code d'invitation est le seul secret qui protège le groupe :
/// il est court pour être dicté au téléphone, mais tiré au hasard sur un
/// alphabet sans caractères ambigus.
model Groupe {
  id               String   @id @default(cuid())
  nom              String
  codeInvitation   String   @unique @map("code_invitation")
  /// Quand c'est vrai, on ne voit les journées des autres qu'après avoir posé
  /// la sienne. Réglable par le groupe.
  revelerApresPost Boolean  @default(true) @map("reveler_apres_post")
  creeLe           DateTime @default(now()) @map("cree_le")

  membres      Membre[]
  declencheurs Declencheur[]
  entrees      Entree[]
  capsules     Capsule[]
  etiquettes   Etiquette[]
  parties      Partie[]
  cartes       CarteBande[]
  pouls        Pouls[]

  @@map("bande_groupes")
}

/// Une personne dans une bande.
///
/// Pas d'email, pas de mot de passe : l'identité tient dans un cookie signé.
/// Le code de reprise est l'unique moyen de retrouver son compte depuis un
/// autre appareil, et il vient en deux moitiés : `poigneeReprise` est publique
/// et indexée — elle seule permet de retrouver la ligne sans balayer la table —
/// tandis que le secret n'est gardé que sous forme d'empreinte. C'est un mot de
/// passe, il en mérite le traitement.
model Membre {
  id             String   @id @default(cuid())
  groupeId       String   @map("groupe_id")
  pseudo         String
  /// 1 à 7 — index dans la palette validée. Le plafond de sept membres par
  /// bande vient de là : au-delà, deux teintes ne se distinguent plus.
  teinte         Int
  poigneeReprise String   @unique @map("poignee_reprise")
  codeReprise    String   @map("code_reprise")
  /// La photo de profil, carrée, en JPEG — c'est nous qui la fabriquons, donc
  /// pas besoin d'une colonne pour le type. Vide tant que personne n'en a mis :
  /// l'avatar porte alors les initiales, ce qui marche très bien.
  avatar         Bytes?
  creeLe         DateTime @default(now()) @map("cree_le")
  vuLe           DateTime @default(now()) @map("vu_le")
  /// Changer de pseudo ou de photo ne touche à aucune journée. Sans cette
  /// colonne dans l'empreinte de synchronisation, les autres garderaient
  /// l'ancien nom et l'ancienne tête jusqu'à la prochaine écriture — c'est le
  /// même défaut que les photos et les notes vocales avaient eu.
  modifieLe      DateTime @default(now()) @updatedAt @map("modifie_le")
  /// La dernière fois que cette personne a ouvert le fil. Distincte de
  /// `vuLe`, qui ne bouge qu'en posant sa journée : le repère « nouveau depuis
  /// ta dernière visite » a besoin de la visite, pas de la publication.
  filVuLe        DateTime? @map("fil_vu_le")

  /// Ce qu'on accepte de recevoir, par type. Une personne, pas un appareil :
  /// choisir « pas les réactions » sur son téléphone et les recevoir sur sa
  /// tablette n'aurait aucun sens. Voir `src/lib/pousse/types.ts`.
  notifications Json @default("{}")

  groupe       Groupe        @relation(fields: [groupeId], references: [id], onDelete: Cascade)
  entrees      Entree[]
  reactions    Reaction[]
  commentaires Commentaire[]
  capsules     Capsule[]
  paroles      Parole[]
  pouls        Pouls[]
  abonnements  Abonnement[]

  @@unique([groupeId, pseudo])
  @@index([groupeId])
  @@map("bande_membres")
}

/// Les vannes internes de la bande, configurables : biberon, plante verte, ce
/// que le groupe voudra.
model Declencheur {
  id       String  @id @default(cuid())
  groupeId String  @map("groupe_id")
  nom      String
  emoji    String
  ordre    Int     @default(0)
  actif    Boolean @default(true)

  groupe  Groupe              @relation(fields: [groupeId], references: [id], onDelete: Cascade)
  entrees EntreeDeclencheur[]

  @@index([groupeId])
  @@map("bande_declencheurs")
}

/// Une journée posée.
///
/// `jour` est une date ISO en texte, calée sur la journée de la bande — celle
/// qui ferme à 4 h du matin, pas à minuit. La contrainte d'unicité est le
/// cœur du rituel : une mesure par personne et par jour.
model Entree {
  id        String   @id @default(cuid())
  groupeId  String   @map("groupe_id")
  membreId  String   @map("membre_id")
  jour      String
  joie      Int
  /// Trois mots maximum. C'est ce qu'on relira dans un an, et la contrainte
  /// n'est pas décorative : une phrase entière ne se retient pas.
  titre     String?
  note      String?
  /// Facultatifs, repliés par défaut. Ils n'entrent dans aucun classement :
  /// ce sont deux axes de plus pour se relire, pas deux notes de plus.
  energie   Int?
  /// Affiché « rire » dans l'interface depuis le lot A. La colonne garde son
  /// nom : renommer une colonne pour un mot d'écran, ce serait une migration
  /// risquée sans rien de visible, et l'échelle est la même.
  calme     Int?
  creeLe    DateTime @default(now()) @map("cree_le")
  modifieLe DateTime @updatedAt @map("modifie_le")
  /// Épinglée en haut du fil par n'importe qui de la bande. C'est un geste
  /// collectif, pas un favori personnel : une journée épinglée l'est pour les
  /// trois, sinon le fil ne raconterait pas la même chose à chacun.
  epingle   Boolean  @default(false)

  groupe       Groupe              @relation(fields: [groupeId], references: [id], onDelete: Cascade)
  membre       Membre              @relation(fields: [membreId], references: [id], onDelete: Cascade)
  declencheurs EntreeDeclencheur[]
  etiquettes   EntreeEtiquette[]
  reactions    Reaction[]
  commentaires Commentaire[]
  photos       Media[]
  audio        Audio?

  @@unique([membreId, jour])
  @@index([groupeId, jour])
  @@map("bande_entrees")
}

/// La photo d'une journée, gardée dans la base.
///
/// Un stockage d'objets serait le choix normal, mais il demanderait un compte
/// de plus. À l'échelle d'une bande — une photo par journée, redimensionnée à
/// 1200 pixels dans le navigateur avant l'envoi, donc autour de cent kilo-octets —
/// une année complète pour sept personnes tient dans quelques centaines de
/// méga-octets. Le jour où ça déborde, `depot.ts` est le seul fichier à rouvrir.
/// Une photo ou une vidéo. Le modèle a été renommé quand la vidéo est arrivée ;
/// la TABLE, elle, garde son nom d'origine, et ce n'est pas de la paresse :
/// Prisma ne sait pas reconnaître un renommage de table et produirait un
/// `DROP TABLE` suivi d'un `CREATE`, c'est-à-dire la perte de toutes les
/// photos déjà en ligne. Un nom de table un peu daté coûte moins cher.
model Media {
  id        String   @id @default(cuid())
  /// Plusieurs médias par journée : l'unicité d'origine est levée, et l'ordre
  /// décide de la place dans le carrousel.
  entreeId  String   @map("entree_id")
  ordre     Int      @default(0)
  /// « photo » ou « video ». Une chaîne plutôt qu'une énumération PostgreSQL :
  /// ajouter une valeur à une énumération se fait hors transaction, ce qui rend
  /// la migration plus délicate qu'elle n'en vaut la peine pour deux cas.
  genre     String   @default("photo")
  mime      String
  /// Les octets, quand ils vivent en base. Nuls quand ils sont chez R2 : c'est
  /// `cle` qui dit alors où les relire. Les deux ne sont jamais renseignés en
  /// même temps — ce serait payer deux fois le même fichier.
  octets    Bytes?
  /// La clé de l'objet distant, ou rien. C'est le seul témoin de l'endroit où
  /// vivent les octets, et il se lit ligne par ligne : la migration peut donc
  /// s'arrêter au milieu sans rien casser.
  cle       String?
  largeur   Int
  hauteur   Int
  /// En millisecondes, pour les vidéos seulement.
  duree     Int?
  /// La vignette, fabriquée par nous — en WebP quand le moteur sait l'encoder,
  /// en JPEG sinon. Son type vit dans `mimeVignette` : le servir en dur comme
  /// du JPEG afficherait du WebP sous une étiquette fausse.
  ///
  /// Le fil sert celle-ci, jamais l'original : afficher une image de 1200 px
  /// dans une case de 160 fait payer à celui qui lit une résolution qu'il ne
  /// verra pas, et pour une vidéo ce serait le fichier entier.
  vignette  Bytes?
  /// La clé de la vignette distante. Indépendante de celle de l'original : une
  /// vignette pèse quarante kilo-octets, un original quatre méga — on peut très
  /// bien vouloir migrer l'un sans l'autre.
  cleVignette String? @map("cle_vignette")
  /// Nul pour les vignettes d'avant le lot M : elles sont toutes en JPEG, et
  /// c'est ce que la lecture suppose quand la colonne est vide.
  mimeVignette String? @map("mime_vignette")
  /// Le poids du fichier, en octets, indépendamment de l'endroit où il vit.
  ///
  /// Sans lui, l'écran de stockage mentirait dès le déménagement chez R2 :
  /// `octet_length(octets)` rend zéro sur une colonne vidée, et la jauge
  /// annoncerait une base vide pendant que le seau se remplit.
  poids         Int     @default(0)
  poidsVignette Int     @default(0) @map("poids_vignette")
  /// SHA-256 du fichier, en hexadécimal. Sert à reconnaître les doublons —
  /// la même photo envoyée deux fois depuis deux téléphones, ou deux fois par
  /// la même personne qui a oublié.
  empreinte     String?
  /// Deux mots sous l'image. Facultatif, comme tout le reste.
  legende   String?
  creeLe    DateTime @default(now()) @map("cree_le")
  /// Remplacer un média ne change ni leur nombre ni leur date de création :
  /// sans cette colonne, le remplacement passerait inaperçu du sondage, et les
  /// autres garderaient l'ancienne image à l'écran.
  ///
  /// Le `@default(now())` n'est pas décoratif : une colonne obligatoire ajoutée
  /// sans valeur par défaut fait échouer la migration dès qu'il existe une
  /// ligne — en développement comme en production.
  modifieLe DateTime @default(now()) @updatedAt @map("modifie_le")

  entree Entree @relation(fields: [entreeId], references: [id], onDelete: Cascade)

  @@index([entreeId, ordre])
  @@map("bande_photos")
}

/// La note vocale d'une journée : trente secondes, pas plus.
///
/// `niveaux` garde l'enveloppe sonore mesurée à l'enregistrement — une
/// soixantaine d'entiers. La forme d'onde du fil se dessine donc à partir du
/// vrai son, et non d'un motif décoratif qui serait le même pour tout le monde.
/// Sans ça, il faudrait décoder l'audio à chaque affichage.
model Audio {
  id        String   @id @default(cuid())
  entreeId  String   @unique @map("entree_id")
  mime      String
  /// Même règle que pour les médias : en base, ou chez R2, jamais les deux.
  octets    Bytes?
  cle       String?
  /// Le poids réel, quel que soit l'endroit. Voir `Media.poids`.
  poids     Int      @default(0)
  /// En millisecondes.
  duree     Int
  niveaux   Int[]
  creeLe    DateTime @default(now()) @map("cree_le")
  modifieLe DateTime @default(now()) @updatedAt @map("modifie_le")

  entree Entree @relation(fields: [entreeId], references: [id], onDelete: Cascade)

  @@map("bande_audios")
}

/// Un appareil abonné aux notifications poussées.
///
/// Une ligne par APPAREIL, pas par personne : le même compte peut être ouvert
/// sur un téléphone et une tablette, et chacun a son adresse d'abonnement et
/// ses clés. Elles viennent du navigateur, qui les fabrique lui-même — nous ne
/// possédons que la moitié publique de la paire VAPID qui signe les envois.
///
/// Une adresse d'abonnement périme : le navigateur la renouvelle, ou l'utilisateur
/// désinstalle. Le serveur de pousse répond alors 404 ou 410, et la ligne part.
model Abonnement {
  id        String   @id @default(cuid())
  membreId  String   @map("membre_id")
  /// L'adresse du serveur de pousse. Unique : un même appareil ne s'abonne
  /// qu'une fois, et se réabonner remplace.
  endpoint  String   @unique
  /// La clé publique du navigateur, en base64url.
  p256dh    String
  /// Le secret d'authentification, en base64url. C'est lui qui empêche le
  /// serveur de pousse de fabriquer un message valide.
  auth      String
  creeLe    DateTime @default(now()) @map("cree_le")
  /// Le dernier envoi accepté. Sert à repérer un abonnement qui ne répond plus.
  vuLe      DateTime @default(now()) @map("vu_le")

  membre Membre @relation(fields: [membreId], references: [id], onDelete: Cascade)

  @@index([membreId])
  @@map("bande_abonnements")
}

/// Une étiquette libre de la bande : sport, taf, soirée, glandage.
///
/// Elle vit au niveau du groupe et non de la journée : c'est ce qui permet
/// l'autocomplétion sur celles déjà utilisées, et ce qui rend les statistiques
/// possibles. Le nom normalisé sert de clé — « Soirée » et « soirée » sont la
/// même étiquette.
model Etiquette {
  id        String   @id @default(cuid())
  groupeId  String   @map("groupe_id")
  /// La position, ARRONDIE à deux décimales — environ un kilomètre. Assez pour
  /// poser un point sur une carte et reconnaître un quartier ; pas assez pour
  /// retrouver une adresse. L'arrondi se fait avant le stockage : arrondir à
  /// l'affichage laisserait la précision en base, où elle finirait par
  /// ressortir. Vide pour un lieu tapé à la main.
  latitude  Float?
  longitude Float?
  nom       String
  cle       String
  creeLe    DateTime @default(now()) @map("cree_le")

  groupe  Groupe            @relation(fields: [groupeId], references: [id], onDelete: Cascade)
  entrees EntreeEtiquette[]

  @@unique([groupeId, cle])
  @@map("bande_etiquettes")
}

model EntreeEtiquette {
  entreeId    String @map("entree_id")
  etiquetteId String @map("etiquette_id")

  entree    Entree    @relation(fields: [entreeId], references: [id], onDelete: Cascade)
  etiquette Etiquette @relation(fields: [etiquetteId], references: [id], onDelete: Cascade)

  @@id([entreeId, etiquetteId])
  @@index([etiquetteId])
  @@map("bande_entree_etiquettes")
}

model EntreeDeclencheur {
  entreeId      String @map("entree_id")
  declencheurId String @map("declencheur_id")

  entree      Entree      @relation(fields: [entreeId], references: [id], onDelete: Cascade)
  declencheur Declencheur @relation(fields: [declencheurId], references: [id], onDelete: Cascade)

  @@id([entreeId, declencheurId])
  @@map("bande_entree_declencheurs")
}

/// Un mot écrit aujourd'hui, scellé jusqu'à une date choisie.
///
/// Le texte est en clair en base : ce n'est pas un secret cryptographique, et
/// prétendre le contraire serait mentir. C'est une convention entre amis — le
/// serveur ne le rend simplement pas avant la date. Le README le dit aussi.
/// Un scellé : quelque chose qu'on s'envoie à soi-même, ou à la bande, pour
/// plus tard. Il n'y avait que des mots ; il y a maintenant aussi des photos,
/// des vidéos et des voix.
model Capsule {
  id       String   @id @default(cuid())
  groupeId String   @map("groupe_id")
  membreId String   @map("membre_id")
  /// « mot », « photo », « video » ou « audio ».
  genre    String   @default("mot")
  /// Toujours renseigné : c'est le mot pour un scellé « mot », et la légende
  /// pour les autres. Un scellé sans un mot d'introduction ne dit rien de ce
  /// qu'on attendait en le fermant.
  texte    String
  /// Le contenu, pour les scellés qui en portent un.
  octets   Bytes?
  mime     String?
  /// L'aperçu, déjà flouté à la fabrication — voir le commentaire de la route.
  apercu   Bytes?
  /// En millisecondes, pour une vidéo ou une voix.
  duree    Int?
  /// Jour d'ouverture, ISO `AAAA-MM-JJ`, calé sur la journée de la bande.
  ouvrirLe String   @map("ouvrir_le")
  /// Quand la bande a été PRÉVENUE de l'ouverture. Nulle tant qu'elle ne l'a
  /// pas été : c'est ce qui rend le réveil quotidien rejouable sans envoyer la
  /// même notification deux fois.
  annonceLe DateTime? @map("annonce_le")
  creeLe   DateTime @default(now()) @map("cree_le")

  groupe Groupe @relation(fields: [groupeId], references: [id], onDelete: Cascade)
  membre Membre @relation(fields: [membreId], references: [id], onDelete: Cascade)

  @@index([groupeId, ouvrirLe])
  @@map("bande_capsules")
}

model Reaction {
  id       String   @id @default(cuid())
  entreeId String   @map("entree_id")
  membreId String   @map("membre_id")
  emoji    String
  creeLe   DateTime @default(now()) @map("cree_le")

  entree Entree @relation(fields: [entreeId], references: [id], onDelete: Cascade)
  membre Membre @relation(fields: [membreId], references: [id], onDelete: Cascade)

  @@unique([entreeId, membreId, emoji])
  @@index([entreeId])
  @@map("bande_reactions")
}

model Commentaire {
  id       String   @id @default(cuid())
  entreeId String   @map("entree_id")
  membreId String   @map("membre_id")
  texte    String
  creeLe   DateTime @default(now()) @map("cree_le")

  entree Entree @relation(fields: [entreeId], references: [id], onDelete: Cascade)
  membre Membre @relation(fields: [membreId], references: [id], onDelete: Cascade)

  @@index([entreeId])
  @@map("bande_commentaires")
}

/// Une partie.
///
/// Une seule table pour les dix jeux, avec une clé `jeu` : ils partagent tous
/// la même forme — des joueurs, des manches, des points — et une table par jeu
/// aurait multiplié par dix le code de lecture pour la même chose.
///
/// `finieLe` distingue une partie en cours d'une partie terminée. Une partie
/// abandonnée reste `null` : on ne l'efface pas, elle a eu lieu, mais elle ne
/// compte pas au palmarès.
model Partie {
  id          String    @id @default(cuid())
  groupeId    String    @map("groupe_id")
  /// La clé du jeu — « devine-qui », « jamais », « top3 »… Voir `src/lib/jeux`.
  jeu         String
  /// « multi » : chacun sur son téléphone, et c'est le mode par défaut depuis
  /// le lot N. « un-telephone » reste là pour dépanner — un téléphone à plat,
  /// quelqu'un sans l'application installée.
  mode        String    @default("multi")
  commenceeLe DateTime  @default(now()) @map("commencee_le")
  finieLe     DateTime? @map("finie_le")

  /// L'hôte : celui qui a ouvert le salon, et qui lance. Transférable — une
  /// partie ne doit jamais rester bloquée parce que quelqu'un est parti.
  hoteId      String?   @map("hote_id")
  /// Le code à quatre chiffres, en secours quand la notification n'arrive pas.
  /// Nul une fois la partie finie : un code ne doit pas rester valable.
  code        String?
  /// « salon » → « encours » → « finie ».
  etat        String    @default("salon")
  /// Où en est la manche, du point de vue du serveur. Chaque jeu y met ses
  /// propres noms de phase ; la coquille ne connaît que l'idée d'une phase qui
  /// change, et d'une échéance au-delà de laquelle on avance quand même.
  phase       String?
  donneesPhase Json     @default("{}") @map("donnees_phase")
  echeance    DateTime?
  /// Incrémenté à CHAQUE changement d'état. C'est ce nombre que le flux
  /// surveille : comparer une version coûte une colonne, comparer un état
  /// entier coûte la partie à chaque battement.
  version     Int       @default(0)

  groupe  Groupe        @relation(fields: [groupeId], references: [id], onDelete: Cascade)
  scores  ScorePartie[]
  manches Manche[]
  actions ActionJoueur[]
  paroles Parole[]

  @@index([groupeId, commenceeLe])
  @@index([groupeId, etat])
  @@map("bande_parties")
}

/// Ce que quelqu'un a dit pendant un jeu, et qu'on garde.
///
/// Deux jeux du lot O s'enregistrent : « La théorie du complot » (quatre-vingt-
/// dix secondes pour relier deux choses sans rapport) et « Le tribunal des
/// idées » (soixante secondes pour défendre une invention). Le jeu n'est pas
/// dans la partie, il est dans la réécoute — d'où une table à part, et pas une
/// note vocale rangée dans une journée : ça n'appartient à aucun jour, ça
/// appartient à une soirée.
///
/// Les octets suivent la même règle que partout : en base, ou chez R2, jamais
/// les deux.
model Parole {
  id       String   @id @default(cuid())
  partieId String   @map("partie_id")
  membreId String   @map("membre_id")
  /// Le numéro de la manche, pour relier l'audio à ce qui était demandé.
  manche   Int
  /// Ce qu'il fallait défendre, recopié : le sujet est tiré au hasard côté
  /// client, et le retrouver en rejouant la manche coûterait plus cher que de
  /// le garder ici.
  sujet    String
  mime     String
  octets   Bytes?
  cle      String?
  /// Le poids réel, quel que soit l'endroit. Voir `Media.poids`.
  poids    Int      @default(0)
  /// En millisecondes.
  duree    Int
  niveaux  Int[]
  /// La note reçue, une fois la manche dépouillée. Nulle tant qu'on n'a pas voté.
  note     Int?
  /// Quand on l'a renvoyée à son auteur, le lendemain matin — c'est le principe
  /// du « Tribunal des idées ». Nulle tant que ce n'est pas fait, et c'est ce
  /// qui empêche de la renvoyer chaque jour jusqu'à la fin des temps.
  renvoyeeLe DateTime? @map("renvoyee_le")
  creeLe   DateTime @default(now()) @map("cree_le")

  partie Partie @relation(fields: [partieId], references: [id], onDelete: Cascade)
  membre Membre @relation(fields: [membreId], references: [id], onDelete: Cascade)

  @@index([partieId, manche])
  @@index([membreId, creeLe])
  @@map("bande_paroles")
}

/// Ce qu'un joueur a fait dans une manche.
///
/// C'est la pièce qui rend le multi possible : l'état ne vit plus dans le
/// téléphone de celui qui anime, il se reconstitue à partir de ces lignes.
/// Quelqu'un qui perd le réseau au milieu d'un vote retrouve la partie exacte
/// en revenant, et personne n'a besoin de lui redemander ce qu'il avait choisi.
model ActionJoueur {
  id       String   @id @default(cuid())
  partieId String   @map("partie_id")
  membreId String   @map("membre_id")
  /// Le numéro de manche, recopié plutôt que référencé : une action arrive
  /// parfois avant que la manche ne soit rangée, et une clé étrangère
  /// obligerait à créer la manche d'abord, donc à attendre.
  manche   Int
  /// La phase visée. Deux votes dans deux phases différentes ne se confondent
  /// pas, et une action en retard d'une phase se reconnaît et s'ignore.
  phase    String
  /// Ce que le joueur a répondu. Le jeu concerné sait le relire.
  donnees  Json     @default("{}")
  creeeLe  DateTime @default(now()) @map("creee_le")

  partie Partie @relation(fields: [partieId], references: [id], onDelete: Cascade)

  /// Un joueur n'a qu'une réponse par phase : la deuxième remplace la première,
  /// ce qui rend l'envoi rejouable sans créer de doublon quand le réseau
  /// hésite.
  @@unique([partieId, manche, phase, membreId])
  @@index([partieId, manche])
  @@map("bande_actions_joueurs")
}

/// Un joueur dans une partie, et ce qu'il y marque.
///
/// `sobre` n'est pas un détail : c'est celui qui conduit. Les jeux qui font
/// boire lui donnent un gage à la place, et le plan est explicite là-dessus.
model ScorePartie {
  id       String  @id @default(cuid())
  partieId String  @map("partie_id")
  membreId String  @map("membre_id")
  points   Int     @default(0)
  sobre    Boolean @default(false)
  /// L'ordre de passage, tiré au début et gardé toute la partie.
  ordre    Int     @default(0)
  /// Le dernier signe de vie. Un téléphone verrouillé cesse d'en donner : au
  /// bout d'un moment, l'écran des autres le montre absent, et la partie peut
  /// avancer sans lui plutôt que de l'attendre indéfiniment.
  vuLe     DateTime @default(now()) @map("vu_le")

  partie Partie @relation(fields: [partieId], references: [id], onDelete: Cascade)

  @@unique([partieId, membreId])
  @@map("bande_scores_partie")
}

/// Une manche.
///
/// `donnees` est du JSON parce que chaque jeu y range autre chose : les cartes
/// trouvées et passées pour « Devine qui je suis », les votes pour « Tu
/// préfères », la question et les réponses pour le quiz. Rien n'est lu sans
/// passer par le lecteur typé du jeu concerné — voir `src/lib/jeux/manche.ts`.
model Manche {
  id       String   @id @default(cuid())
  partieId String   @map("partie_id")
  numero   Int
  /// Le joueur dont c'est le tour, quand le jeu en a un.
  membreId String?  @map("membre_id")
  donnees  Json     @default("{}")
  creeeLe  DateTime @default(now()) @map("creee_le")

  partie Partie @relation(fields: [partieId], references: [id], onDelete: Cascade)

  @@index([partieId, numero])
  @@map("bande_manches")
}

/// Une carte écrite par la bande.
///
/// Les paquets fournis sont dans le code : ce sont des constantes, elles ne
/// changent pas d'une bande à l'autre, et les mettre en base aurait demandé de
/// les recopier à chaque création de bande. Ici, il n'y a que ce que la bande
/// a écrit elle-même — le paquet « Nos potes », ses propres « je n'ai
/// jamais », ses propres dilemmes.
model CarteBande {
  id       String   @id @default(cuid())
  groupeId String   @map("groupe_id")
  /// À quel paquet elle appartient : « potes », « jamais », « prefere »…
  paquet   String   @default("potes")
  texte    String
  /// Qui l'a ajoutée — pour le droit de retrait, et pour ne pas faire deviner
  /// à quelqu'un une carte qu'il vient d'écrire.
  membreId String   @map("membre_id")
  creeeLe  DateTime @default(now()) @map("creee_le")

  groupe Groupe @relation(fields: [groupeId], references: [id], onDelete: Cascade)

  @@index([groupeId, paquet])
  @@map("bande_cartes")
}

/// Un pouls : un relevé express, plusieurs fois par jour.
///
/// Le check-in complet reste **une fois par jour** — c'est le rituel, et le
/// diluer le tuerait. Le pouls est autre chose : deux curseurs, deux taps,
/// aucun texte, autant de fois qu'on veut. Il existe parce qu'un graphique de
/// la journée en cours n'a rien à tracer quand chacun ne pose qu'un point.
///
/// **Il ne rapporte aucun point.** Sinon la façon la plus rapide de monter de
/// niveau serait d'en poser quarante en attendant le bus.
///
/// La colonne s'appelle `rire` et non `calme` : la table est neuve, elle n'a
/// pas à porter le vocabulaire d'avant le lot A.
model Pouls {
  id       String   @id @default(cuid())
  groupeId String   @map("groupe_id")
  membreId String   @map("membre_id")
  /// Jour de la bande, ISO `AAAA-MM-JJ` — la soirée du 4 englobe 1 h du matin.
  jour     String
  rire     Int
  energie  Int
  poseA    DateTime @default(now()) @map("pose_a")

  groupe Groupe @relation(fields: [groupeId], references: [id], onDelete: Cascade)
  membre Membre @relation(fields: [membreId], references: [id], onDelete: Cascade)

  @@index([groupeId, jour])
  @@map("bande_pouls")
}
